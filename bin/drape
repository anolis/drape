#!/usr/bin/env python3
"""Launch the drape GUI, or the CLI when given a subcommand."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

if len(sys.argv) > 1 and (sys.argv[1] in ("-h", "--help") or not sys.argv[1].startswith(("ocs:", "ocss:", "-"))):
    from drape.cli import main
    main()
else:
    from drape.app import main
    sys.exit(main())
